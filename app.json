{
  "expo": {
    "name": "Inventera mera",
    "slug": "inventera-mera",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "inventeramera",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "se.inventeramera.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Inventera mera använder din position när du väljer Min position för att registrera en observation."
      }
    },
    "android": {
      "package": "se.inventeramera.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./icon/app-icon.png",
        "backgroundColor": "#2A6D38"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./icon/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-document-picker",
      "@maplibre/maplibre-react-native",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "688ec7be-0d32-47f2-894d-5ca7d6cf7c5e"
      }
    },
    "owner": "viktor-stahl",
    "icon": "./icon/app-icon.png"
  }
}
