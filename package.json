{
  "name": "inventera-mera",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "android": "node scripts/run-android.mjs",
    "android:java": "node scripts/run-android.mjs --print-java-home",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "taxonomy:build": "node --max-old-space-size=1024 scripts/build-dyntaxa-taxonomy.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "lint": "eslint ."
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@maplibre/maplibre-react-native": "^11.0.0",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-linking": "~57.0.0",
    "expo-location": "~57.0.0",
    "expo-network": "~57.0.0",
    "expo-router": "~57.0.0",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.0",
    "expo-splash-screen": "~57.0.0",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "fflate": "^0.8.2",
    "maplibre-gl": "^6.3.0",
    "proj4": "^2.19.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.8",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
